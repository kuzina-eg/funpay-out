---
import Modal from '@components/modules/Modal.astro';
import Button from '@components/modules/Button.astro';
import Input from '@components/modules/Input.astro';
import FieldBox from '@components/modules/FieldBox.astro';
//import TabMenu from '@components/blocks/TabMenu.astro';

interface Props {
    id?: string;
    title?: string;
    text?: string;
    modalMainColor?: string;
    modalSecondColor?: string;
    buttonAccentText?: string;
    isCancelButton?: boolean;
    isButtonClose?: boolean;
    class?: string;
    [x: string]: any;
}

const {
	id = 'modal-login',
	title = 'Действие',
	text = '<p>Какой ни&nbsp;будь текст или еще что либо под заголовком если потребуется краткое описание</p>',
    modalMainColor,
    modalSecondColor,
    buttonId = '',
    buttonAccentText = 'Удалить',
    isCancelButton = true,
    isButtonClose = true,
	class: className,
	...rest
} = Astro.props;

---
<Modal id={id}
    class={className || 'modal-login'}
    modalMainColor={modalMainColor}
    modalSecondColor={modalSecondColor}
    isCenter={true}
>
