---
<Layout title="Out" bodyClass="out--gradient">
    <div class="out__container container">
        <Promo
            id="promo"
            title="Забирайте скидки<br> до&nbsp;90% На&nbsp;UC"
            text="Подарки для всех:<br> присоединяйся и&nbsp;выбивай скидки"
            buttonText="Участвую!"
            rulesLink="Правила участия"
        ></Promo>
        <Already
            title="Выдали и продолжаем выдавать"
            resultTitle="Выбито призов"
            resultText="Крутые скидки на&nbsp;UC ещё остались. Присоединяйтесь и&nbsp;забирайте свою!"
            resultValue="00 000 001"
            prizes={alreadyPrizes}
            items={alreadyWinners}
            unit="шт."
        ></Already>
        <Instructions
            title="FAQ"
            items={instruction}
            buttonText="Погнали!"
            buttonHref="#promo"
        ></Instructions>
    </div>
</Layout>
