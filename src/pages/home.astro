        discount: 30,
        text: 'Получили > 10&nbsp;чел.',
    },
    {
        image: 'lg',
        prizeValue: 365,
        discount: 50,
        text: 'Получили > 10&nbsp;чел.',
    },
]

const alreadyWinners = [
    {
        image: 'lg',
        prizeValue: 1800,
        discount: 50,
        name: 'Имя пользователя',
        date: '20 минут назад',
    },
    {
        image: 'md',
        prizeValue: 120,
        discount: 50,
        name: 'Имя пользователя',
        date: '20 минут назад',
    },
    {
        image: 'lg',
        prizeValue: 1800,
        discount: 50,
        name: 'Имя пользователя',
        date: '20 минут назад',
    },
    {
        image: 'lg',
        prizeValue: 1800,
        discount: 50,
        name: 'Имя пользователя',
        date: '20 минут назад',
    },
]

const instruction = [
    {
        title: 'Сколько будет длиться акция?',
        text: 'С&nbsp;1 по&nbsp;7 июня 2026&nbsp;года.',
    },
    {
        title: 'Как участвовать?',
        text: 'Войдите в&nbsp;аккаунт, пройдите регистрацию в&nbsp;акции, нажмите кнопку &laquo;Участвую!&raquo;, вращайте барабан, получайте скидки, оформляйте заказы со&nbsp;скидкой.',
    },
    {
        title: 'Что делать, если я&nbsp;не&nbsp;хочу использовать скидку сразу?',
        text: 'Скидка будет доступна во&nbsp;вкладке &laquo;Призы&raquo; в&nbsp;правом нижнем углу барабана, вы&nbsp;можете воспользоваться ей&nbsp;позже.',
    },
    {
        title: 'Как долго хранятся призы?',
        text: 'Скидки можно использовать только во&nbsp;время действия самой акции.',
    },
