            buttonText="Подписаться на новости"
            prizeButtonText="Призы"
        ></Promo>
        <Already
            title="Сколько скидок раздали<br> с&nbsp;<strong>1</strong> по&nbsp;<strong>7</strong>&nbsp;июня"
            resultTitle="Сколько участников получили классные скидки на&nbsp;UC"
            resultValue="1 234 301"
            prizes={alreadyPrizes}
            unit="чел."
            isFinish={true}
        ></Already>
        <Participants
            title="Топовые участники"
            items={participants}
        ></Participants>
        <FinishFooter
            title="Новый розыгрыш<br> совсем скоро!"
            buttonText="Подписаться на розыгрыши"
        ></FinishFooter>
    </div>


    <Fragment slot="modals">
        <ModalPrizes
            title="призы"
            tabTitlePrizes="Можно выиграть"
            tabTitleMyPrizes="Вы выиграли"
            closeText="Закрыть"
            items={prizesItems}
            myPrizes={myPrizes}
            discountText="со скидкой"
            emptyText="Вы&nbsp;пока ничего<br> не&nbsp;выиграли"
        ></ModalPrizes>
    </Fragment>
</Layout>
