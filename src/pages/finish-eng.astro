        <Already
            title="How many discounts were given away<br> from September 17&nbsp;to&nbsp;October&nbsp;17"
            resultTitle="How many participants got their awesome discounts on&nbsp;gems and passes"
            resultValue="1 234 301"
            prizes={alreadyPrizes}
            unit=""
            isFinish={true}
        ></Already>
        <Participants
            title="Top participants"
            items={participants}
        ></Participants>
        <FinishFooter
            title="New giveaway<br> dropping soon!"
            buttonText="Subscribe for more giveaways"
        ></FinishFooter>
    </div>


    <Fragment slot="modals">
        <ModalPrizes
            title="awards"
            tabTitlePrizes="You can win"
            tabTitleMyPrizes="You won"
            closeText="Close"
            items={prizesItems}
            myPrizes={myPrizes}
            discountText="discount"
            emptyText="You haven't won<br> anything yet"
        ></ModalPrizes>
    </Fragment>
</Layout>
