---
<Layout title="Out" bodyClass="out--gradient">
    <div class="out__container container">
        <Promo
            title="Акцію завершено&nbsp;&mdash; дякуємо за&nbsp;участь!"
            text="Учасники вибили понад 10&nbsp;000&nbsp;знижок.<br> Новий розіграш&nbsp;&mdash; зовсім скоро"
            buttonText="Підписатись на новини"
            prizeButtonText="Нагороди"
        ></Promo>
        <Already
            title="Скільки знижок роздали<br> з&nbsp;<strong>17</strong>&nbsp;вересня по&nbsp;<strong>17</strong>&nbsp;жовтня"
            resultTitle="Скільки учасників отримали круті знижки на&nbsp;геми й&nbsp;паси"
            resultValue="1 234 301"
            prizes={alreadyPrizes}
            unit="чел."
            isFinish={true}
        ></Already>
        <Participants
            title="Топові учасники"
            items={participants}
        ></Participants>
        <FinishFooter
            title="Новий розіграш<br> зовсім скоро!"
            buttonText="Підписатись на нові розіграші"
        ></FinishFooter>
    </div>


    <Fragment slot="modals">
        <ModalPrizes
            title="Нагороди"
            tabTitlePrizes="Ви можете виграти"
            tabTitleMyPrizes="Ви виграли"
            closeText="Закрыть"
            items={prizesItems}
            myPrizes={myPrizes}
            discountText=""
            emptyText="Ви ще нічого<br> не виграли"
        ></ModalPrizes>
    </Fragment>
</Layout>
